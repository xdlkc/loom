{
  "manifest_version": 3,
  "name": "本机模型额度同步",
  "version": "1.3.4",
  "description": "本机同步 Grok、Gemini、MiniMax 额度及官方 Token 消耗；不读取 Cookie 或令牌。",
  "key": "",
  "permissions": [
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "https://grok.com/dashboard/*",
    "https://gemini.google.com/*",
    "http://127.0.0.1:4318/*",
    "https://platform.minimax.cn/*",
    "https://platform.deepseek.com/*"
  ],
  "background": {
    "service_worker": "service-worker-v120.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://grok.com/dashboard/*"
      ],
      "js": [
        "reader.js",
        "content.js",
        "token-reader.js",
        "token-content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": [
        "gemini-reader.js",
        "gemini-content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://platform.minimax.cn/console/usage*"
      ],
      "js": [
        "minimax-reader.js",
        "minimax-content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://platform.deepseek.com/usage",
        "https://platform.deepseek.com/profile"
      ],
      "js": [
        "token-reader.js",
        "token-content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup-v120.html"
  }
}