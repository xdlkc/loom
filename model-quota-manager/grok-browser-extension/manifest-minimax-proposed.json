{
  "manifest_version": 3,
  "name": "本机模型额度同步",
  "version": "1.2.3",
  "description": "读取 Grok、指定 Gemini 账号额度与 MiniMax 套餐 Token 消耗。登录态留在 Chrome，不读取 Cookie 或令牌。",
  "key": "",
  "permissions": [
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "https://grok.com/dashboard/*",
    "https://gemini.google.com/*",
    "http://127.0.0.1:4318/*",
    "https://platform.minimax.cn/*"
  ],
  "background": {
    "service_worker": "service-worker-v120.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://grok.com/dashboard/*"
      ],
      "js": [
        "reader.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": [
        "gemini-reader.js",
        "gemini-content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://platform.minimax.cn/console/usage*"
      ],
      "js": [
        "minimax-reader.js",
        "minimax-content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup-v120.html"
  }
}